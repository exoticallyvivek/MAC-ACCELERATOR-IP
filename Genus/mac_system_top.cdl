       (result_mac2), .result_mac3 (result_mac3), .valid_mac0
       (valid_mac0), .valid_mac1 (valid_mac1), .valid_mac2
       (valid_mac2), .valid_mac3 (valid_mac3), .reg_mac0 (orb_result0),
       .reg_mac1 (orb_result1), .reg_mac2 (orb_result2), .reg_mac3
       (orb_result3), .done_flag (orb_done));
  wire w20106;
  and g502 (fifo_wr_en, w20106, axi_mac_start);
  not g21680 (w20106, fifo_full);
  wire w20107, w20108;
  nand g589 (n_22, w20107, w20108);
  or g21682 (w20108, n_4, n_18);
  or g21681 (w20107, n_21, fifo_empty);
  DFFRHQX1 busy_reg_reg(.RN (ARESETN), .CK (ACLK), .D (n_19), .Q
