  wire w20111;
  nand g598 (n_20, w20111, n_13);
  or g21685 (w20111, fifo_empty, n_10, n_1);
  wire w20112;
  nand g599 (n_19, w20112, n_168);
  nand g21686 (w20112, n_14, busy_reg);
  wire w20113;
  nor g600 (n_18, n_6, n_1, w20113);
  and g21687 (w20113, fsm_state[0], fsm_state[1]);
  and g601 (n_17, fifo_empty, n_9, n_0);
  wire w20114;
  nand g602 (n_16, w20114, n_13);
  or g21688 (w20114, n_9, n_3);
  wire w20115;
  and g603 (n_15, w20115, n_9);
  not g21689 (w20115, fifo_empty);
  nand g604 (n_14, n_10, n_1);
  wire w20116;
  nand g605 (n_11, w20116, n_7);
  not g21690 (w20116, n_169);
  nand g606 (n_13, n_169, n_0);
  nor g608 (n_10, n_0, fsm_state[0]);
