module DFFRHQX1(CK, D, RN, Q);
  input CK, D, RN;
  output Q;
  wire CK, D, RN;
  wire Q;
  wire next_state;
  reg  qi;
  assign #1 Q = qi;
  assign next_state = D;
  always 
    @(posedge CK or negedge RN) 
      if (!RN) 
        qi <= 0;
      else qi <= next_state;
  initial 
    qi <= 1'b0;
endmodule

module SDFFRHQX1(CK, D, SE, SI, RN, Q);
  input CK, D, SE, SI, RN;
  output Q;
  wire CK, D, SE, SI, RN;
  wire Q;
  wire next_state, w20119, w20120, w20121;
  reg  qi;
  assign #1 Q = qi;
  not g21693 (w20119, SE);
  nand g21694 (w20120, w20119, D);
  nand g21695 (w20121, SI, SE);
  nand g21696 (next_state, w20120, w20121);
  always 
    @(posedge CK or negedge RN) 
      if (!RN) 
        qi <= 0;
      else qi <= next_state;
  initial 
    qi <= 1'b0;
endmodule

